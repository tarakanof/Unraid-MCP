# ── Unraid connection (required) ───────────────────────────────────────────
# Full GraphQL endpoint of your Unraid server. If you omit the path, "/graphql"
# is appended automatically. Use https with a hostname that matches the cert.
UNRAID_API_URL=https://yourhash.myunraid.net/graphql

# API key for the Unraid GraphQL API. Create one in the Unraid WebGUI
# (Settings → Management Access → API Keys) or via the CLI on the server:
#   unraid-api apikey --create --name mcp --roles guest
# For monitoring only, a least-privilege (guest / read) key is sufficient.
UNRAID_API_KEY=replace-me

# ── TLS ─────────────────────────────────────────────────────────────────────
# Verify the server's TLS certificate. A CA bundle can trust a self-signed cert,
# but it cannot fix a hostname/IP mismatch; for LAN IP URLs, use a matching cert
# or disable verification only on a trusted LAN.
UNRAID_VERIFY_SSL=true
# Path to a custom CA bundle (PEM) to trust the Unraid certificate.
# UNRAID_CA_BUNDLE=/path/to/unraid-ca.pem

# ── Transport ───────────────────────────────────────────────────────────────
# "stdio" (default, for local subprocess clients) or "streamable-http".
UNRAID_MCP_TRANSPORT=stdio
# Bind address + port for streamable-http (defaults bind to localhost only).
UNRAID_MCP_HOST=127.0.0.1
UNRAID_MCP_PORT=6750
# Bearer token required from MCP clients on the streamable-http transport.
# Must be at least 32 random characters and cannot be a placeholder.
# If unset while using http, a random token is generated and printed to stderr.
# UNRAID_MCP_BEARER_TOKEN=
# Comma-separated Host / Origin allow-lists for DNS-rebinding protection on the
# HTTP transport. Required when binding to a non-localhost host (e.g. in Docker)
# to keep DNS-rebinding protection enabled. Include the LAN IP/name clients use.
# Example:
# UNRAID_MCP_ALLOWED_HOSTS=tower.local:6750,10.0.0.5:6750
# UNRAID_MCP_ALLOWED_ORIGINS=https://my-ui.example
# Serve the HTTP transport over HTTPS directly (set BOTH). Otherwise terminate
# TLS at a reverse proxy; the server warns if it serves plaintext off localhost.
# UNRAID_MCP_TLS_CERT=/path/to/cert.pem
# UNRAID_MCP_TLS_KEY=/path/to/key.pem

# ── Safety switches ─────────────────────────────────────────────────────────
# Mutating tools (start/stop array, docker/VM control, notification changes) are
# only registered when this is true. Destructive ones also require confirm=true.
UNRAID_MCP_ALLOW_MUTATIONS=false
# DANGER: high-blast-radius mutations (array topology — add/remove/mount/unmount
# disk, clear disk stats; permanently remove a Docker container/image). Only takes
# effect when UNRAID_MCP_ALLOW_MUTATIONS is ALSO true; enabling this alone does
# nothing. Leave false unless you deliberately want an agent able to reshape the
# array or delete containers. Each still requires confirm=true.
UNRAID_MCP_ALLOW_DANGEROUS=false
# Register a read-only raw GraphQL passthrough tool (rejects mutations).
UNRAID_MCP_ALLOW_RAW_QUERY=false

# ── Misc ────────────────────────────────────────────────────────────────────
UNRAID_MCP_TIMEOUT=30
UNRAID_MCP_LOG_LEVEL=INFO
